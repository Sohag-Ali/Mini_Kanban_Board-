# Local Docker Environment Configuration Example

# PostgreSQL Service Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mini_kanban
POSTGRES_PORT=5432

# Backend Service Config
BACKEND_PORT=5000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mini_kanban?schema=public
JWT_ACCESS_SECRET=docker_local_dev_access_secret_key_123456789
JWT_REFRESH_SECRET=docker_local_dev_refresh_secret_key_123456789
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Frontend Service Config
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
